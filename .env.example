# ==========================================
# ConnectPro Enterprise Messaging Configuration
# ==========================================

# 1. DATABASE CONFIGURATION
# Local SQLite (Default for rapid zero-config local development):
DATABASE_URL="file:./dev.db"

# Neon PostgreSQL (Production Cloud Database):
# Switch schema.prisma provider to "postgresql" and paste your Neon connection string:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sparkling-wave-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION & SECURITY
JWT_SECRET="connectpro_super_secure_jwt_secret_company_messaging_key_2026"
PORT=3000

# 3. APPLICATION BRANDING
NEXT_PUBLIC_APP_NAME="ConnectPro"
NEXT_PUBLIC_APP_TAGLINE="Enterprise Private Messaging"

# 4. CLOUDFLARE R2 OBJECT STORAGE (Zero Egress Costs)
# In production, binary files (images, audio, video, documents) are stored in Cloudflare R2.
# When these variables are omitted, ConnectPro gracefully falls back to local disk storage in /public/uploads.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="connectpro-media"
CLOUDFLARE_R2_PUBLIC_URL=""
