datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  phone        String   @unique
  passwordHash String
  displayName  String
  avatar       String?
  designation  String?
  department   String?
  role         String   @default("EMPLOYEE") // SUPER_ADMIN, ADMIN, MANAGER, EMPLOYEE
  status       String   @default("ACTIVE")   // ACTIVE, SUSPENDED
  isOnline     Boolean  @default(false)
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       ConversationMember[]
  messages          Message[]
  receipts          MessageReceipt[]
  callsInitiated    CallLog[]            @relation("CallerCalls")
  callsReceived     CallLog[]            @relation("ReceiverCalls")
  auditLogs         AuditLog[]
  storageAuditLogs  StorageAuditLog[]

  waAccountsConnected WhatsAppAccount[]      @relation("WAAccountConnectedBy")
  waChatsAssigned     WhatsAppChat[]         @relation("WAChatAssignedTo")
  waMessagesSent      WhatsAppMessage[]      @relation("WAMessageSentBy")
  waInternalNotes     WhatsAppInternalNote[] @relation("WANoteAuthor")

  @@index([department])
  @@index([status])
  @@index([isOnline])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  isGroup       Boolean  @default(false)
  name          String?
  description   String?
  avatar        String?
  createdById   String?
  isImportant   Boolean  @default(false) // Safety: Important conversations are never automatically deleted
  retentionDays Int?     // Group files configurable retention (e.g. 30, 90, 180, 365, null = never)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
  @@index([isGroup])
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String   @default("MEMBER") // ADMIN, MEMBER
  joinedAt       DateTime @default(now())
  isMuted        Boolean  @default(false)
  isArchived     Boolean  @default(false)
  isPinned       Boolean  @default(false)
  isImportant    Boolean  @default(false)
  unreadCount    Int      @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           String   @default("TEXT") // TEXT, IMAGE, VIDEO, AUDIO, DOCUMENT, VOICE
  fileUrl        String?  // Public / secure download URL
  fileKey        String?  // Cloudflare R2 object storage key or local file key
  fileName       String?  // Original file name
  fileSize       Int?     // Size in bytes
  mimeType       String?  // MIME type (image/webp, video/mp4, etc.)
  thumbnailUrl   String?  // Compressed lightweight preview thumbnail
  isTemporary    Boolean  @default(false) // 7-day auto-expiry temporary file
  isImportant    Boolean  @default(false) // Safety: Important/starred messages never purged
  replyToId      String?
  isEdited       Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?         @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("MessageReplies")
  receipts     MessageReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([type])
  @@index([fileSize])
  @@index([createdAt])
  @@index([isTemporary])
}

model MessageReceipt {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  status    String    @default("SENT") // SENT, DELIVERED, READ
  readAt    DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model CallLog {
  id          String    @id @default(cuid())
  callerId    String
  receiverId  String
  type        String    @default("AUDIO") // AUDIO, VIDEO
  status      String    @default("COMPLETED") // MISSED, COMPLETED, REJECTED, BUSY
  durationSec Int       @default(0)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  caller   User @relation("CallerCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([startedAt])
}

model RetentionPolicy {
  id                     String    @id @default(cuid())
  temporaryFileDays      Int       @default(7)    // Temporary files: 7 days default
  voiceRetentionDays     Int       @default(90)   // Voice notes: 90 days default
  callLogRetentionDays   Int       @default(180)  // Call logs: 180 days default
  groupFileRetentionDays Int       @default(365)  // Group media: 365 days (configurable)
  autoPurgeEnabled       Boolean   @default(false)// Automatic background execution
  warningThreshold       Int       @default(70)   // 70% capacity notification
  criticalThreshold      Int       @default(85)   // 85% capacity notification
  emergencyThreshold     Int       @default(95)   // 95% capacity notification
  storageQuotaBytes      Float     @default(10737418240) // 10 GB storage quota default
  lastRunAt              DateTime?
  updatedAt              DateTime  @updatedAt
}

model StorageAuditLog {
  id            String   @id @default(cuid())
  action        String   // RETENTION_PURGE, MANUAL_FILE_DELETE, STORAGE_ALERT
  policyName    String?
  itemsPurged   Int      @default(0)
  bytesFreed    Float    @default(0)
  executedById  String?
  details       String?
  createdAt     DateTime @default(now())

  executedBy User? @relation(fields: [executedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model WhatsAppAccount {
  id                   String    @id @default(cuid())
  wabaId               String    @unique
  phoneNumberId        String    @unique
  displayPhoneNumber   String
  verifiedName         String?
  accessTokenEncrypted String
  coexistenceEnabled   Boolean   @default(true)
  status               String    @default("CONNECTED") // CONNECTED, SYNCING, DISCONNECTED, INACTIVE_WARNING
  appVersionConfirmed  String?
  historySyncStatus    String    @default("PENDING")   // PENDING, IN_PROGRESS, COMPLETED, EXPIRED
  historySyncProgress  Int       @default(0)           // 0 to 100
  historyTriggeredAt   DateTime?
  contactSyncStatus    String    @default("PENDING")   // PENDING, COMPLETED
  lastWebhookAt        DateTime?
  lastEchoAt           DateTime?
  connectedByUserId    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  connectedBy User?          @relation("WAAccountConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  chats       WhatsAppChat[]

  @@index([status])
}

model WhatsAppChat {
  id                 String    @id @default(cuid())
  accountId          String
  customerWaId       String
  customerPhone      String
  customerName       String?
  customerAvatar     String?
  assignedToUserId   String?
  status             String    @default("OPEN") // OPEN, PENDING, RESOLVED
  unreadCount        Int       @default(0)
  lastCustomerMsgAt  DateTime?
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  lastMessageSource  String?   // CUSTOMER, CONNECTPRO, PHYSICAL_PHONE, HISTORY_SYNC
  isPinned           Boolean   @default(false)
  isArchived         Boolean   @default(false)
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account    WhatsAppAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("WAChatAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages   WhatsAppMessage[]
  notes      WhatsAppInternalNote[]

  @@unique([accountId, customerWaId])
  @@index([accountId, lastMessageAt(sort: Desc)])
  @@index([assignedToUserId, lastMessageAt(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc)])
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  chatId         String
  waMessageId    String   @unique
  direction      String   // INBOUND, OUTBOUND
  source         String   // CUSTOMER, CONNECTPRO, PHYSICAL_PHONE, HISTORY_SYNC
  sentByUserId   String?
  type           String   @default("TEXT") // TEXT, IMAGE, VIDEO, AUDIO, VOICE, DOCUMENT, STICKER, LOCATION, REACTION, SYSTEM
  content        String   @default("")
  mediaId        String?
  fileUrl        String?
  fileKey        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  thumbnailUrl   String?
  replyToWaMsgId String?
  reactionEmoji  String?
  status         String   @default("SENT") // PENDING, SENT, DELIVERED, READ, FAILED
  statusRank     Int      @default(1)      // 0=PENDING, 1=SENT, 2=DELIVERED, 3=READ, -1=FAILED
  errorCode      String?
  errorMessage   String?
  isEdited       Boolean  @default(false)
  isRevoked      Boolean  @default(false)
  waTimestamp    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chat   WhatsAppChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sentBy User?        @relation("WAMessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([chatId, waTimestamp(sort: Asc)])
  @@index([sentByUserId])
  @@index([source])
}

model WhatsAppInternalNote {
  id        String   @id @default(cuid())
  chatId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat   WhatsAppChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User         @relation("WANoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt(sort: Asc)])
}

model WhatsAppWebhookEvent {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  eventType      String   // messages, smb_message_echoes, statuses, history, smb_app_state_sync, account_update
  wabaId         String?
  phoneNumberId  String?
  waMessageId    String?
  status         String   @default("PROCESSED") // PROCESSING, PROCESSED, FAILED
  retryCount     Int      @default(0)
  payloadJson    String
  errorDetails   String?
  createdAt      DateTime @default(now())

  @@index([eventType, createdAt(sort: Desc)])
  @@index([waMessageId])
}
